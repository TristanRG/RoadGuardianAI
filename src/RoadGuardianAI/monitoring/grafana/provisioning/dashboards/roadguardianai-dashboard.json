{
  "dashboard": {
    "id": null,
    "uid": "roadguardian-overview",
    "title": "RoadGuardian - Overview",
    "tags": ["roadguardian","api","prometheus"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "timeseries",
        "title": "Request rate (req/s)",
        "gridPos": {"x":0,"y":0,"w":12,"h":8},
        "id": 1,
        "targets": [
          {
            "expr": "sum by (endpoint, method) (rate(rg_http_requests_total[5m]))",
            "legendFormat": "{{endpoint}} {{method}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "req/s"},
          "overrides": []
        }
      },
      {
        "type": "timeseries",
        "title": "Request latency P95 (seconds)",
        "gridPos": {"x":12,"y":0,"w":12,"h":8},
        "id": 2,
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(rg_http_request_latency_seconds_bucket[5m])))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s"},
          "overrides": []
        }
      },
      {
        "type": "bargauge",
        "title": "Requests by endpoint (last 5m)",
        "gridPos": {"x":0,"y":8,"w":12,"h":6},
        "id": 3,
        "targets": [
          {
            "expr": "sum by (endpoint) (increase(rg_http_requests_total[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "lcd"
        }
      },
      {
        "type": "stat",
        "title": "Predictions total (counter)",
        "gridPos": {"x":12,"y":8,"w":6,"h":4},
        "id": 4,
        "targets": [
          {
            "expr": "rg_predictions_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none"}}
      },
      {
        "type": "stat",
        "title": "Model loaded",
        "gridPos": {"x":18,"y":8,"w":6,"h":4},
        "id": 5,
        "targets": [
          {
            "expr": "rg_model_loaded",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "mappings": [
              { "operator": "value", "options": { "0": { "color": "red", "text": "down" }, "1": { "color": "green", "text": "loaded" } } }
            ]
          }
        }
      },
      {
        "type": "table",
        "title": "Recent request counts (by endpoint & status)",
        "gridPos": {"x":0,"y":14,"w":24,"h":8},
        "id": 6,
        "targets": [
          {
            "expr": "sum by (endpoint, method, status_code) (increase(rg_http_requests_total[5m]))",
            "refId": "A",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "none"},
          "overrides": []
        }
      }
    ],
    "templating": {"list": []},
    "time": { "from": "now-1h", "to": "now" }
  },
  "overwrite": true
}
